{
  "name": "@squareboat/nest-queue-sqs",
  "version": "0.1.0",
  "description": "The AWS SQS queue package for your NestJS Applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nestjs",
    "nestjs-queue",
    "nestjs-queueing",
    "nestjs-sqs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/squareboat/nest-queue-sqs.git"
  },
  "bugs": {
    "url": "https://github.com/squareboat/nest-queue-sqs/issues"
  },
  "homepage": "https://github.com/squareboat/nest-queue-sqs#readme",
  "author": "Squareboat <hi@squareboat.com>",
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint 'lib/**/*.ts' --fix",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:e2e": "jest --config ./tests/jest-e2e.json --runInBand",
    "test:e2e:dev": "jest --config ./tests/jest-e2e.json --runInBand --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@aws-sdk/credential-providers": "^3.1161.0",
    "@squareboat/nest-queue-strategy": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
